# رابط قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb?schema=public"

# اسم المستخدم وكلمة مرور لوحة التحكم (غيّرها قبل التشغيل الفعلي)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangeThisPassword123!"

# مفتاح سري لتوقيع جلسات الدخول (استخدم نص عشوائي طويل وقوي)
JWT_SECRET="please-change-this-to-a-long-random-secret-string"

# اسم الجمعية/المبادرة الذي يظهر على الكروت والموقع
NEXT_PUBLIC_ORG_NAME="توزيع شنط لوجه الله"
